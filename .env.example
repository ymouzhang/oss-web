# 登录账号（必填）
OSS_WEB_USER=admin
OSS_WEB_PASSWORD=change-me-to-a-strong-password

# 阿里云 OSS 凭证（必填，建议使用最小权限 RAM 用户）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=cn-hangzhou
# 默认选中的 bucket（可选；不填则进入时先展示 bucket 列表）
# OSS_BUCKET=my-bucket

# 自定义 Endpoint（可选；不填则按 Region 推导公网域名）
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# ECS 同地域可用内网域名提速降本（与 OSS_ENDPOINT 二选一）
# OSS_USE_INTERNAL_ENDPOINT=true

# 本地文件根目录（容器内路径，默认 /data）
# LOCAL_ROOT=/data
# 断点续传 checkpoint 目录（默认 $LOCAL_ROOT/.oss-checkpoints）
# CHECKPOINT_DIR=/data/.oss-checkpoints

# 传输参数（可选）
# TRANSFER_PART_SIZE_MB=8
# TRANSFER_PARALLEL_NUM=4
# TRANSFER_FILE_CONCURRENCY=2

# 监听端口
# PORT=8080

# 跳过启动时的 OSS 连通性自检（仅调试用）
# SKIP_OSS_CHECK=false
